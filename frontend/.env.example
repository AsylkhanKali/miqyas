# Frontend environment variables (Vite — must be prefixed with VITE_)

# Backend API base URL (leave blank to use same-origin / dev proxy)
VITE_API_URL=

# Groq API key — powers the free MIQYAS AI chatbot (llama-3.3-70b) on the
# Al Falah room pages. Get a free key at https://console.groq.com/keys
# Note: this is exposed in the browser bundle, so use a key you're comfortable
# shipping to a local/pilot demo. For production, proxy chat through the backend.
VITE_GROQ_API_KEY=
